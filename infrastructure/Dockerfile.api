FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# Shell form so a host-injected $PORT (e.g. Render) is honoured, with a local
# fallback to 8000. Runs migrations first: with DEBUG=false the app does NOT
# auto-create tables (table creation is dev-only, see app/main.py). `exec` hands
# signals to uvicorn for a clean shutdown. docker-compose is unaffected — it
# overrides this command with its own --reload dev server.
CMD sh -c "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
