# FORGE AI — API configuration
# Copy to .env for local dev, or set these as environment variables on your host.

# --- Database ---------------------------------------------------------------
# Local Postgres (docker-compose):
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forge_ai
# Managed Postgres (Neon / Supabase / Render) works too — paste the provider's
# connection string as-is. A plain "postgres://..." or "postgresql://..." scheme
# and a "?sslmode=require" param are handled automatically (upgraded to the
# asyncpg driver, SSL enabled). Example:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.neon.tech/DBNAME?sslmode=require

# --- Security & Auth --------------------------------------------------------
# MUST be a strong random value in production (>= 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=forge-ai-production-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slash).
# For a deployed demo, set this to your Vercel URL, e.g.:
#   CORS_ORIGINS=https://forge-ai.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional services ------------------------------------------------------
# Redis is optional; leave unset to run without it.
REDIS_URL=redis://localhost:6379/0

# --- Runtime ----------------------------------------------------------------
# Set DEBUG=false in production (disables SQL echo and the local dev auto-login path).
DEBUG=true
HOST=0.0.0.0
PORT=8000
