# FORGE AI — web (Next.js) configuration
# Copy to .env.local for local dev, or set these in your host's env (e.g. Vercel
# Project Settings → Environment Variables). NEXT_PUBLIC_* values are embedded in
# the client bundle, so never put secrets here.

# Backend REST API base (note the /api suffix).
# Local:
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Deployed demo (point at your API host, keep the /api suffix):
#   NEXT_PUBLIC_API_URL=https://forge-ai-api.onrender.com/api

# Backend user WebSocket stream (the user id is appended at runtime).
# Local:
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/user
# Deployed demo — use wss:// (TLS) against the same API host:
#   NEXT_PUBLIC_WS_URL=wss://forge-ai-api.onrender.com/ws/user

# Auto sign-in with the seeded local dev account so the app works with no setup.
# This only works when the backend runs with DEBUG=true (the seeded account is
# dev-only). Set to "false" for a production/demo backend running with DEBUG=false.
NEXT_PUBLIC_DEV_AUTOLOGIN=true

# Absolute path to the local-agent launcher for the "Connect Agent" command.
# Local-dev only; leave unset on a deployed frontend.
# NEXT_PUBLIC_AGENT_SCRIPT=D:\path\to\forge-ai\scripts\run-agent.ps1
